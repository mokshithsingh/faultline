# ---------- Docker deployment (docker-compose.yml) ----------

# Password of the `faultline` Postgres user.
# IMPORTANT: Postgres only applies this when the data volume is first created.
# Changing it later does NOT change the real password.
DB_PASSWORD=your_secure_db_password_here

# Secret for signing login tokens (32+ random chars). Generate: openssl rand -hex 32
# Required: docker compose refuses to start without it.
JWT_SECRET=your_jwt_secret_32_characters_minimum_here

# Optional Google Gemini API key for AI error explanations
# (without it, a built-in rule-based explanation is used).
GEMINI_API_KEY=

# ---------- Local development only (npm start in server/) ----------
PORT=4000
DB_URL=postgresql://faultline:your_secure_db_password_here@localhost:5432/faultline

# ---------- Faultline SDK & demo app ----------
FAULTLINE_API_KEY=flt_your_project_api_key_here
FAULTLINE_ENDPOINT=http://localhost:4000/v1/ingest
DEMO_PORT=5000
