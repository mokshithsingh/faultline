# Faultline Ingest API Key from your project in Faultline dashboard
FAULTLINE_API_KEY=flt_your_project_api_key_here

# Faultline Ingest Endpoint (defaults to http://localhost:4000/v1/ingest)
FAULTLINE_ENDPOINT=http://localhost:4000/v1/ingest

# Port for demo server (defaults to 5000)
DEMO_PORT=5000
